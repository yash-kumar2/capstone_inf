POSTGRES_DB=invoice_auditor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
ERP_BASE_URL=http://localhost:8001
AGENT_URL=http://localhost:8000
AWS_REGION_NAME=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_SESSION_TOKEN=
MODEL_REASONING=bedrock/amazon.nova-lite-v1:0
MODEL_GENERATION=bedrock/cohere.command-r-plus-v1:0
MODEL_TRANSLATION=bedrock/cohere.command-r-plus-v1:0
MODEL_EMBEDDING=bedrock/amazon.titan-embed-text-v2:0
EMBED_DIM=1024
OCR_LANGS=eng+spa+deu+fra
MONITOR_POLL_SECONDS=3
RAG_PASS_THRESHOLD=0.7
RAG_MAX_RETRIES=3
CACHE_TTL_SECONDS=604800
LOG_LEVEL=INFO
