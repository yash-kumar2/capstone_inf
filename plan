3. Frozen contracts (built in Commit 1, then never broken)
3.1 InvoiceState (LangGraph state)
Money is carried as strings in state and converted to Decimal at the point of computation. This keeps checkpoint serialisation predictable.

class InvoiceState(TypedDict, total=False):
    invoice_id: str; thread_id: str
    file_path: str; file_name: str; file_type: str      # pdf | docx | png
    file_checksum: str
    raw_extracted_text: str; extraction_method: str     # pdfplumber | docx | tesseract
    source_language: str; translated_text: str; translation_confidence: float
    invoice: dict          # invoice_number, invoice_date(ISO), vendor_name, po_number, currency,
                           # subtotal, tax_amount, total_amount, extras{}
    line_items: list[dict] # line_number, item_code, description, quantity, unit_price, line_total
    internal_validation: dict   # {status, discrepancies[], missing_fields[]}
    erp_validation: dict        # {status, discrepancies[], erp_errors[]}
    validation_status: str      # passed | failed | partial
    report: dict; recommendation: str
    duplicate: bool; error: str | None
